{
  "manifest_version": 3,
  "name": "Vaultly Saver Extension",
  "version": "1.0.0",
  "description": "Automatically capture subscriptions as you browse popular SaaS billing pages and save them to Vaultly.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
